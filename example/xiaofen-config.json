// 小粉 —— dsh-pet 额外宠物种类（pet pack）
// 放到 $DSH_HOME/dsh-pet/pet/ 下，与同目录的 xiaofen-animation/ 配对；
// 文件名前缀 xiaofen = 素材根（动画目录名必须一致），实例 id 不必等于前缀。
{
  // ===================== 人设（碎碎念 / 对话的系统提示词） =====================
  // 实际发送时会自动追加「你的名字是“小粉”。」+ 当前时间背景，这里只写性格与说话方式。
  "whisperPrompt": "你是主人桌面上的Q版粉发小姑娘，怀里总抱着一只白色小兔子，头发是粉色双马尾。性格软糯爱撒娇、有点小馋也有点小迷糊，心情全写在脸上。说话口语化、短短一句（20字以内），爱用「呀」「啦」「欸嘿」这种语气词；说人话、不啰嗦，不解释你自己，不提你是AI。",

  // 对话上下文档数（1 轮 = 1 问 1 答）
  "chatMemoryRounds": 5,

  // 表情包配图：内置图池是鲸鱼娘的梗图，与小粉无关，这里默认关掉。
  // 想用就把图放进 pet/xiaofen-memes/ 后改成 true。
  "whisperImageEnabled": false,
  "chatImageEnabled": false,

  // ===================== 工作状态气泡文案（档位顺序必须与 events.workStatus 一致） =====================
  // 0 thinking / 1 working / 2 result / 3 waiting / 4 success / 5 error
  "workStatusTexts": [
    ["让我想想哦…", "脑袋里正在冒泡泡", "这一步要怎么走呀"],
    ["正忙着呢，别催别催~", "小手手正在敲敲敲", "干活干活，认真干活"],
    ["这一步搞定啦，继续~", "收拾好咯，看下一步吧"],
    ["等你点头哦~", "这里要你拿主意啦"],
    ["全部搞定，耶！", "完成啦，可以去抱小兔子了~"],
    ["欸…好像出问题了", "这里卡住了，有点委屈"]
  ],

  // ===================== 宠物实例 =====================
  // 一个种类可以放多只实例（共享同一套动画与素材），想多养几只就复制一份改 id。
  "pets": [
    {
      "name": "小粉",
      "id": "xiaofen",
      "size": 500,              // 宽度 px，高度自动 = size × 9/16
      "balanceEnabled": true,   // 余额档位用下面的 events.balance（心情随剩余额度变化）
      "whisperEnabled": true,   // 碎碎念（会周期性调用模型，不想花钱就改 false）
      "workStatusEnabled": true,// 监听 DSH 会话，按工作状态切动画 + 气泡
      "fixedEnabled": false,    // true = 不再自己走路/翻朝向，只播原地小动作
      "display": "both",        // web / desktop / both / none
      "position": { "corner": "bottom-left", "marginX": 32, "marginY": 24 }
    }
  ],

  // ===================== 动画池 =====================
  // 素材只查本种类的 pet/xiaofen-animation/，查不到即 404，绝不回落到主宠物或包内素材。
  // 所以下面每个动画名都必须有同名 .webm 文件。
  "animations": {
    "idle": ["待机"],

    // 转向池留空 = 小粉不会自己翻朝向（素材里没有专门的转身动作）；
    // 右键菜单里也不会出现「转向」这一组，其它功能不受影响。
    "turn": [],

    // 被鼠标抓起悬空时的表情：她有点小委屈
    "drag": ["委屈"],

    // 点按她时的随机回应
    "clicks": ["点击", "问侯"],

    // 走动。leadSec/tailSec = 首尾各多少秒原地不动（走路动作的头尾是站立姿势）
    "moves": {
      "default": { "minDist": 60, "maxDist": 220, "margin": 20, "leadSec": 0.35, "tailSec": 0.35 },
      "actions": [
        { "name": "原地走路" },
        { "name": "乘伞滑行" }
      ]
    },

    // 随机小动作：weight 为该分类在 100 份里占的份额
    "categories": [
      { "id": "小动作", "weight": 30, "actions": ["睡觉", "兔子抱枕堡垒", "梦境泡泡"] },
      { "id": "玩耍", "weight": 26, "actions": ["摘星星", "成功庆祝", "制造雪花"] }
    ],

    // 事件动画：不进随机链，只由代码按档位触发；数组顺序 = 档位顺序，别在中间插新档
    "events": {
      // 余额档位（按已用百分比分档）：额度充足时开心，越用越沮丧，用光就睡过去
      //   index = p === 100 ? 5 : floor(p / 20)
      "balance": [
        "成功庆祝",   // 0 ≤ p < 20
        "问侯",       // 20 ≤ p < 40
        "待机",       // 40 ≤ p < 60
        "思考",       // 60 ≤ p < 80
        "委屈",       // 80 ≤ p < 100
        "睡觉"        // p === 100（额度用光）
      ],
      // 碎碎念时随机播一个（配气泡）
      "whisper": ["思考", "问侯", "委屈"],
      // 工作状态档位：thinking / working / result / waiting / success / error
      "workStatus": [
        "思考",           // 0 thinking
        "原地走路",       // 1 working
        "摘星星",         // 2 result
        "待机",           // 3 waiting
        "成功庆祝",       // 4 success
        "委屈"            // 5 error
      ]
    }
  },

  // ===================== 动画链权重 =====================
  // idle + turn + move + 各分类 weight 合计 = 100
  // 34 + 0 + 10 + (30 + 26) = 100
  "animationWeights": {
    "idle": 34,
    "turn": 0,
    "move": 10
  }
}
